<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kirin_Tool</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <Product>Kirin Tool for Linux</Product>
    <!-- Version is the single source of truth. Do not pin FileVersion/InformationalVersion:
         they were pinned at 2.4.13 and every later release reported 2.4.13 to users
         (found by the 2.4.15 real-device smoke test). tests/VersionMetadata guards this. -->
    <Version>2.4.19</Version>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <!-- The compiler-warning budget is tree-wide now: see Directory.Build.props / docs/warnings-policy.md.
         It used to live here; it moved so the tests/ harnesses are gated too. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="tests/**" />
    <AvaloniaXaml Remove="tests/**" />
    <!-- The CLI/MCP entry is a separate project under KirinTool.Cli/; keep it out of
         this project's default globs so its generated AssemblyInfo is not compiled twice. -->
    <Compile Remove="KirinTool.Cli/**/*.cs" />
    <EmbeddedResource Remove="KirinTool.Cli/**" />
    <AvaloniaXaml Remove="KirinTool.Cli/**" />
    <None Remove="KirinTool.Cli/**" />
    <Content Include="logo.ico" />
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <Content Include="Assets/Fonts/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="fastboot/payload">
      <Link>fastboot/payload</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="loaders/**/*">
      <Link>loaders/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="BouncyCastle.NetCore" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.15" />
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Avalonia" />
    <Using Include="Avalonia.Controls" />
    <Using Include="Avalonia.Threading" />
  </ItemGroup>

  <Target Name="BuildUsbUpdateBridge" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="make -C &quot;$(MSBuildProjectDirectory)/native/usb-update&quot;" />
  </Target>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="native/usb-update/libkirin_usb_update.so" Link="libkirin_usb_update.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
