<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kirin_Tool.UI">
  <!-- Recreated from the frozen WPF layout, using native Avalonia controls. -->
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}"/>
  </Style>
  <!-- Warning banner: defined at application scope so the theme dictionary is
       re-resolved when the light/dark variant changes. -->
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource AppNoticeBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppNoticeBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="Button, ui|WindowsButton">
    <Setter Property="Background" Value="{DynamicResource AppButtonBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.accent, ui|WindowsButton.accent">
    <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
  </Style>
  <Style Selector="Button.caution, ui|WindowsButton.caution">
    <Setter Property="Background" Value="{DynamicResource AppCautionBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppCautionBorderBrush}"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource AppInputBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorderBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>
  <Style Selector="ListBox#NavigationListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,0"/>
  </Style>
  <Style Selector="ListBoxItem.navigation">
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="NavigationBackground" Background="Transparent" CornerRadius="4">
          <Grid>
            <Border Name="SelectionIndicator" Width="3" Height="16" Background="{DynamicResource AppAccentBrush}" CornerRadius="2" HorizontalAlignment="Left" IsVisible="False"/>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem.navigation:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
  </Style>
  <Style Selector="ListBoxItem.navigation:pointerover /template/ Border#NavigationBackground">
    <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}"/>
  </Style>
  <Style Selector="ListBoxItem.navigation:selected /template/ Border#NavigationBackground">
    <Setter Property="Background" Value="{DynamicResource AppNavSelectedBrush}"/>
  </Style>
  <Style Selector="ListBoxItem.navigation:selected /template/ Border#SelectionIndicator">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="ui|WindowsExpander">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <StackPanel>
            <ToggleButton Classes="card-header" AutomationProperties.Name="{TemplateBinding Header}" MinHeight="58" Padding="16,12" HorizontalAlignment="Stretch"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <Grid ColumnDefinitions="24,*,16">
                <ui:WindowsSymbol Symbol="{TemplateBinding Icon}" FontSize="20" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" Margin="12,0" VerticalAlignment="Center"/>
                <Path Name="ExpanderChevron" Grid.Column="2" Data="M2,8 L7,3 L12,8" Stroke="{DynamicResource AppIconBrush}" StrokeThickness="1" Width="12" Height="10" VerticalAlignment="Center">
                  <Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform>
                </Path>
              </Grid>
            </ToggleButton>
            <Border Name="ExpandedContent" IsVisible="{TemplateBinding IsExpanded}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="14,16">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
            </Border>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.card-header">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="HeaderBackground" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.card-header:pointerover /template/ Border#HeaderBackground">
    <Setter Property="Background" Value="{DynamicResource AppSubtleBrush}"/>
  </Style>
  <Style Selector="ui|WindowsExpander[IsExpanded=True] /template/ Path#ExpanderChevron">
    <Setter Property="RenderTransform"><RotateTransform Angle="0"/></Setter>
  </Style>
  <Style Selector="ui|WindowsCard">
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource AppCardBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,12">
          <Grid ColumnDefinitions="24,2*,3*">
            <ui:WindowsSymbol Symbol="{TemplateBinding Icon}" FontSize="18" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalContentAlignment="Right"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.caption, ui|WindowsButton.caption">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter, ui|WindowsButton.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppNavHoverBrush}"/>
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter, ui|WindowsButton.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppCaptionCloseHoverBrush}"/>
  </Style>
  <Style Selector="ui|WindowsButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <ui:WindowsSymbol Symbol="{TemplateBinding Symbol}" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="1" Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ui|WindowsButton:pointerover /template/ Border#ButtonSurface">
    <Setter Property="Opacity" Value="0.85"/>
  </Style>
  <Style Selector="ui|WindowsButton:pressed /template/ Border#ButtonSurface">
    <Setter Property="Opacity" Value="0.7"/>
  </Style>
  <Style Selector="ui|WindowsButton:disabled">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource AppDisabledBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBorderBrush}"/>
  </Style>
  <Style Selector="Button.infobar-close, ui|WindowsButton.infobar-close">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
</Styles>
