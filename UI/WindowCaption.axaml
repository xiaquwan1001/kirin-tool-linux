<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kirin_Tool.UI.WindowCaption" Height="48">
  <Grid ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource AppWindowBackgroundBrush}">
    <Border Background="Transparent" PointerPressed="DragTitleBar">
      <TextBlock x:Name="CaptionTitle" Margin="32,0" VerticalAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource AppTextBrush}"/>
    </Border>
    <!-- Theme switcher: applies immediately and is persisted by UserSettings. -->
    <ComboBox x:Name="ThemeSelector" Grid.Column="1" MinWidth="132" Margin="0,7,12,7"
              VerticalAlignment="Center" AutomationProperties.Name="Theme"
              SelectionChanged="ThemeSelectionChanged">
      <ComboBoxItem Content="Light" Tag="light"/>
      <ComboBoxItem Content="Dark" Tag="dark"/>
      <ComboBoxItem Content="Follow system" Tag="system"/>
    </ComboBox>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
      <Button Classes="caption" AutomationProperties.Name="Minimize" Click="MinimizeWindow">
        <Path Data="M0,5 L10,5" Stroke="{DynamicResource AppIconBrush}" StrokeThickness="1" Width="10" Height="10"/>
      </Button>
      <Button Classes="caption" AutomationProperties.Name="Maximize or restore" Click="ToggleMaximize">
        <Path Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="{DynamicResource AppIconBrush}" StrokeThickness="1" Width="10" Height="10"/>
      </Button>
      <Button Classes="caption close" AutomationProperties.Name="Close" Click="CloseWindow">
        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource AppIconBrush}" StrokeThickness="1" Width="10" Height="10"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
