<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Kirin_Tool.Models"
        x:Class="Kirin_Tool.UI.ProgressDialog"
        Title="Unlock in Progress"
        Width="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False" SystemDecorations="BorderOnly">

  <Border Background="{DynamicResource AppCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
    <StackPanel Margin="32,24,32,24">
      <ItemsControl ItemsSource="{Binding ProgressItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding FileName}"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         Margin="0,0,16,0"/>
              <ProgressBar Grid.Column="1"
                           Value="{Binding ProgressValue}"
                           Margin="16,0,16,0"
                           VerticalAlignment="Center"
                           Height="12"
                           MinWidth="200"/>
              <TextBlock Grid.Column="2"
                         Text="{Binding StatusText}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource AppMutedTextBrush}"
                         Margin="16,0,0,0"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Margin="0,32,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name="OverallStatusTextBlock"
                   Grid.Column="0"
                   Text="Initializing..."
                   Foreground="DimGray"
                   TextWrapping="Wrap"
                   FontSize="14"
                   VerticalAlignment="Center"/>

        <Button Name="CloseButton"
                Grid.Column="1"
                Content="OK"
                Width="80"
                Height="32"
                Margin="16,0,0,0"
                IsVisible="False"
                Click="CloseButton_Click"/>
      </Grid>

      <!-- Session audit log path: stays on screen after the run so it can be cat-ed later. -->
      <SelectableTextBlock Name="LogPathTextBlock"
                           Margin="0,12,0,0"
                           Foreground="DimGray"
                           TextWrapping="Wrap"
                           FontSize="12"
                           IsVisible="False"
                           Text=""/>
    </StackPanel>
  </Border>
</Window>
