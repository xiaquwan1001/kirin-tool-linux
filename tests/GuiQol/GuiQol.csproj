<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Hosts that ship a newer shared runtime (e.g. only 10.0 installed) must still be
         able to run this watchdog-free headless check. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../Kirin-Tool.csproj" /><PackageReference Include="Avalonia.Headless" Version="11.3.3" /></ItemGroup>
</Project>
